# Copia este archivo como .env y cambia los valores. NUNCA subas .env a Git.

# Base de datos (PostgreSQL + PostGIS)
POSTGRES_DB=urbanos
POSTGRES_USER=urbanos
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (tareas en segundo plano, desde la Etapa 2)
REDIS_URL=redis://redis:6379/0

# Backend (Django)
DJANGO_SECRET_KEY=cambia-esta-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Servicio de IA (FastAPI)
AI_SERVICE_URL=http://ai-service:8001
AI_MODE=simulado   # simulado | real
